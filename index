<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Africaland — Actualités et histoire de l'Afrique</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

<!-- GOOGLE ADSENSE SCRIPT PRINCIPAL -->
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX"
     crossorigin="anonymous"></script>

<style>
  :root{
    --bg:#1b140f;
    --bg-elevated:#241a13;
    --bg-card:#2a1f16;
    --line: rgba(243,233,217,0.12);
    --gold:#d9a441;
    --gold-soft:#b3843a;
    --indigo:#3a5a86;
    --clay:#a6553b;
    --ink:#f3e9d9;
    --ink-muted:#c9b8a0;
    --ink-faint:#8f7d68;
    --radius-s:2px;
    --radius-m:6px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--ink);
    font-family:'Work Sans', sans-serif;
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.serif{
    font-family:'Newsreader', serif;
    font-weight:600;
    letter-spacing:-0.01em;
    margin:0;
  }
  a{color:inherit;text-decoration:none;}
  button{font-family:inherit;cursor:pointer;}
  img{max-width:100%;display:block;}
  ::selection{background:var(--gold);color:#1b140f;}

  .kente-rule{
    height:6px;
    background:repeating-linear-gradient(
      90deg,
      var(--gold) 0px, var(--gold) 18px,
      var(--clay) 18px, var(--clay) 26px,
      var(--indigo) 26px, var(--indigo) 44px,
      transparent 44px, transparent 52px
    );
    opacity:0.9;
  }

  header{
    position:sticky; top:0; z-index:50;
    background:rgba(27,20,15,0.92);
    backdrop-filter:blur(8px);
    border-bottom:1px solid var(--line);
  }
  .nav-wrap{
    max-width:1180px; margin:0 auto;
    display:flex; align-items:center; justify-content:space-between;
    padding:16px 24px;
    gap:16px;
  }
  .logo{
    font-family:'Newsreader', serif;
    font-size:24px; font-weight:700;
    display:flex; align-items:baseline; gap:2px;
  }
  .logo em{font-style:normal; color:var(--gold);}
  nav.primary-nav{display:flex; gap:28px; font-size:14.5px;}
  nav.primary-nav a{color:var(--ink-muted); transition:color .15s;}
  nav.primary-nav a:hover{color:var(--ink);}
  .nav-right{display:flex; align-items:center; gap:14px;}
  select#langSelect{
    background:var(--bg-elevated);
    color:var(--ink);
    border:1px solid var(--line);
    border-radius:var(--radius-s);
    padding:7px 10px;
    font-size:13.5px;
    font-family:inherit;
  }
  .btn{
    display:inline-block;
    padding:9px 18px;
    border-radius:var(--radius-s);
    font-size:14px; font-weight:600;
    border:1px solid transparent;
  }
  .btn-gold{background:var(--gold); color:#1b140f;}
  .btn-gold:hover{background:#e8b558;}
  .btn-outline{border-color:var(--line); color:var(--ink);}
  .btn-outline:hover{border-color:var(--ink-muted);}
  .menu-toggle{display:none; background:none; border:none; color:var(--ink); font-size:22px;}

  .hero{
    max-width:1180px; margin:0 auto;
    padding:56px 24px 40px;
    display:grid; grid-template-columns:1.1fr 0.9fr; gap:48px;
    align-items:end;
  }
  .hero-eyebrow{
    font-size:13px; color:var(--gold); font-weight:600;
    margin-bottom:14px; display:block;
  }
  .hero h1{
    font-size:clamp(36px, 5vw, 58px);
    line-height:1.04;
    margin-bottom:18px;
  }
  .hero p.lede{
    color:var(--ink-muted); font-size:17px; max-width:46ch; margin-bottom:26px;
  }
  .hero-actions{display:flex; gap:12px;}
  .hero-side{
    background:var(--bg-card);
    border:1px solid var(--line);
    border-radius:var(--radius-m);
    padding:22px;
  }
  .hero-side h3{font-size:14px; color:var(--ink-faint); font-weight:600; margin-bottom:14px;}
  .ticker-item{
    display:flex; gap:12px; padding:12px 0;
    border-bottom:1px solid var(--line);
    font-size:14.5px;
  }
  .ticker-item:last-child{border-bottom:none; padding-bottom:0;}
  .ticker-thumb{
    width:44px; height:44px; border-radius:var(--radius-s); flex-shrink:0;
    position:relative; overflow:hidden;
    display:flex; align-items:center; justify-content:center;
  }
  .ticker-thumb svg{width:22px; height:22px; color:var(--ink); opacity:.9;}
  .ticker-thumb .mini-flag{
    position:absolute; bottom:1px; right:1px; font-size:11px;
    background:rgba(27,20,15,.85); border-radius:50%; width:16px; height:16px;
    display:flex; align-items:center; justify-content:center;
  }
  .ticker-item strong{display:block; font-weight:600; margin-bottom:2px;}
  .ticker-item span.meta{color:var(--ink-faint); font-size:12.5px;}

  section{max-width:1180px; margin:0 auto; padding:52px 24px;}
  .section-head{
    display:flex; align-items:baseline; justify-content:space-between;
    margin-bottom:28px; flex-wrap:wrap; gap:10px;
    border-bottom:1px solid var(--line);
    padding-bottom:16px;
  }
  .section-head h2{font-size:28px;}
  .section-head p{color:var(--ink-faint); font-size:14px; max-width:44ch;}

  /* Style pour les conteneurs de publicité AdSense */
  .ad-banner-container {
    max-width: 1180px;
    margin: 20px auto;
    padding: 0 24px;
    text-align: center;
    overflow: hidden;
  }

  .filter-row{
    display:flex; gap:10px; flex-wrap:wrap; margin-bottom:28px;
  }
  .pill{
    padding:8px 16px;
    border-radius:999px;
    border:1px solid var(--line);
    background:transparent;
    color:var(--ink-muted);
    font-size:13.5px; font-weight:500;
    transition:all .15s;
  }
  .pill:hover{border-color:var(--ink-muted); color:var(--ink);}
  .pill.active{background:var(--gold); color:#1b140f; border-color:var(--gold);}

  .news-grid{display:grid; grid-template-columns:repeat(3, 1fr); gap:20px;}
  .news-card{
    background:var(--bg-card);
    border:1px solid var(--line);
    border-radius:var(--radius-m);
    overflow:hidden;
    display:flex; flex-direction:column;
  }
  .news-card .card-body{padding:18px 20px 20px; display:flex; flex-direction:column; gap:10px;}
  .card-image{
    height:150px; position:relative;
    overflow:hidden;
    display:flex; align-items:center; justify-content:center;
  }
  .card-image svg{ width:64px; height:64px; color:var(--ink); opacity:.85; position:relative; z-index:1; }
  .card-image .cat-tag{position:absolute; top:10px; left:10px; z-index:2;}
  .card-image .flag-badge{
    position:absolute; bottom:10px; right:10px; z-index:2;
    width:30px; height:30px; border-radius:50%;
    background:var(--bg-elevated); border:1px solid rgba(255,255,255,.25);
    display:flex; align-items:center; justify-content:center;
    font-size:15px; box-shadow:0 2px 6px rgba(0,0,0,.4);
  }
  .card-image::before{
    content:""; position:absolute; inset:0; opacity:.16; z-index:0;
    background:repeating-linear-gradient(115deg, #fff 0px, #fff 2px, transparent 2px, transparent 22px);
  }
  .img-actualite{background:linear-gradient(135deg, var(--indigo), #223349);}
  .img-documentation{background:linear-gradient(135deg, var(--clay), #5e3020);}
  .img-innovation{background:linear-gradient(135deg, var(--gold), #8a6423);}
  .img-histoire{background:linear-gradient(135deg, #6b5738, #2c2318);}
  .news-card .tag-row{display:flex; justify-content:space-between; align-items:center;}
  .cat-tag{
    font-size:11px; font-weight:600; letter-spacing:0.02em;
    padding:3px 9px; border-radius:999px;
  }
  .cat-actualite{background:rgba(58,90,134,.35); color:#a9c2e0;}
  .cat-documentation{background:rgba(166,85,59,.35); color:#e3ab97;}
  .cat-innovation{background:rgba(217,164,65,.28); color:#f0cd8a;}
  .cat-histoire{background:rgba(143,125,104,.3); color:var(--ink-muted);}
  .news-card h3{font-size:17px; line-height:1.3;}
  .news-card .source-line{font-size:12.5px; color:var(--ink-faint); display:flex; gap:6px; align-items:center;}
  .ai-summary{font-size:13.5px; color:var(--ink-muted); line-height:1.55; margin:0;}
  .ai-summary::before{content:"✦ "; color:var(--gold);}
  .read-original{
    margin-top:4px; font-size:13px; font-weight:600; color:var(--gold);
    border-top:1px solid var(--line); padding-top:12px;
  }
  .read-original:hover{color:#e8b558; text-decoration:underline;}

  .region-tabs{display:flex; gap:8px; flex-wrap:wrap; margin-bottom:24px;}
  .region-tab{
    padding:7px 14px; font-size:13px; border-radius:var(--radius-s);
    border:1px solid var(--line); color:var(--ink-faint);
  }
  .region-tab.active{border-color:var(--gold); color:var(--gold);}
  .country-grid{display:grid; grid-template-columns:repeat(4, 1fr); gap:14px;}
  .country-card{
    background:var(--bg-card); border:1px solid var(--line); border-radius:var(--radius-m);
    padding:16px; text-align:left; display:flex; flex-direction:column; gap:8px;
    transition:border-color .15s, transform .15s;
  }
  .country-card:hover{border-color:var(--gold-soft); transform:translateY(-2px);}
  .country-card .flag{font-size:28px;}
  .country-card h4{font-size:15.5px; font-family:'Work Sans',sans-serif; font-weight:600;}
  .country-card .cap{font-size:12px; color:var(--ink-faint);}

  .overlay{
    position:fixed; inset:0; background:rgba(10,7,5,0.72);
    display:none; align-items:flex-start; justify-content:center;
    padding:40px 20px; z-index:100; overflow-y:auto;
  }
  .overlay.open{display:flex;}
  .detail-panel{
    background:var(--bg-elevated); border:1px solid var(--line);
    border-radius:var(--radius-m); max-width:680px; width:100%;
    padding:0; overflow:hidden;
  }
  .detail-top{padding:28px 28px 0;}
  .detail-close{float:right; background:none; border:none; color:var(--ink-faint); font-size:22px;}
  .detail-flag{font-size:44px; margin-bottom:10px;}
  .detail-panel h2{font-size:30px; margin-bottom:4px;}
  .detail-meta{color:var(--ink-faint); font-size:13.5px; margin-bottom:20px;}
  .detail-body{padding:0 28px 28px;}
  .detail-body h5{font-size:12.5px; text-transform:none; color:var(--gold); font-weight:600; margin:22px 0 8px;}
  .detail-body p{color:var(--ink-muted); font-size:15px; line-height:1.65;}
  .timeline{position:relative; padding-left:22px; margin-top:6px;}
  .timeline::before{content:""; position:absolute; left:5px; top:6px; bottom:6px; width:2px; background:var(--line);}
  .timeline-item{position:relative; padding-bottom:20px;}
  .timeline-item:last-child{padding-bottom:0;}
  .timeline-item::before{
    content:""; position:absolute; left:-22px; top:4px; width:12px; height:12px;
    border-radius:50%; background:var(--gold); border:2px solid var(--bg-elevated);
  }
  .timeline-item .tl-period{font-size:12.5px; font-weight:600; color:var(--gold); margin-bottom:4px; display:block;}
  .timeline-item p{margin:0; font-size:14.5px;}
  .detail-news-item{
    border-top:1px solid var(--line); padding:14px 0; font-size:14px;
    display:flex; gap:14px;
  }
  .detail-news-thumb{
    width:76px; height:76px; border-radius:var(--radius-s); flex-shrink:0; position:relative; overflow:hidden;
    display:flex; align-items:center; justify-content:center;
  }
  .detail-news-thumb svg{width:34px; height:34px; color:var(--ink); opacity:.9;}
  .detail-news-thumb .mini-flag{
    position:absolute; bottom:2px; right:2px; font-size:12px;
    background:rgba(27,20,15,.85); border-radius:50%; width:18px; height:18px;
    display:flex; align-items:center; justify-content:center;
  }

  .region-toggle{
    display:inline-flex; border:1px solid var(--line); border-radius:999px; padding:4px; margin-bottom:8px;
  }
  .region-toggle button{
    background:none; border:none; color:var(--ink-faint); padding:8px 18px; border-radius:999px; font-size:13.5px; font-weight:600;
  }
  .region-toggle button.active{background:var(--gold); color:#1b140f;}
  .pricing-note{font-size:12.5px; color:var(--ink-faint); margin-bottom:32px;}
  .plans{display:grid; grid-template-columns:1fr 1fr; gap:20px;}
  .plan-card{
    background:var(--bg-card); border:1px solid var(--line); border-radius:var(--radius-m);
    padding:28px;
  }
  .plan-card.premium{border-color:var(--gold);}
  .plan-name{font-size:13px; color:var(--ink-faint); font-weight:600; margin-bottom:10px;}
  .plan-price{font-family:'Newsreader', serif; font-size:40px; margin-bottom:4px;}
  .plan-price span{font-size:15px; color:var(--ink-faint); font-family:'Work Sans', sans-serif;}
  .plan-cadence{font-size:13px; color:var(--ink-faint); margin-bottom:20px;}
  .plan-features{list-style:none; padding:0; margin:0 0 24px; display:flex; flex-direction:column; gap:11px;}
  .plan-features li{font-size:14px; color:var(--ink-muted); display:flex; gap:10px;}
  .plan-features li .dot{color:var(--gold); flex-shrink:0;}
  .push-demo{
    margin-top:18px; padding:14px; background:var(--bg-elevated); border-radius:var(--radius-s);
    display:flex; align-items:center; justify-content:space-between; font-size:13.5px;
  }
  .switch{
    width:38px; height:22px; background:var(--line); border-radius:999px; position:relative; border:none; flex-shrink:0;
  }
  .switch::after{
    content:''; position:absolute; width:16px; height:16px; background:var(--ink-faint);
    border-radius:50%; top:3px; left:3px; transition:all .18s;
  }
  .switch.on{background:var(--gold);}
  .switch.on::after{left:19px; background:#1b140f;}

  .pref-block{
    background:var(--bg-card); border:1px solid var(--line); border-radius:var(--radius-m);
    padding:24px; margin-top:28px;
  }
  .pref-block h4{font-size:15px; margin-bottom:4px;}
  .pref-block p{font-size:13.5px; color:var(--ink-faint); margin:0 0 16px;}

  footer{border-top:1px solid var(--line); padding:40px 24px; margin-top:40px;}
  .footer-inner{max-width:1180px; margin:0 auto; display:flex; justify-content:space-between; flex-wrap:wrap; gap:20px; font-size:13px; color:var(--ink-faint);}

  @media (max-width:860px){
    nav.primary-nav{display:none;}
    .menu-toggle{display:block;}
    .hero{grid-template-columns:1fr;}
    .news-grid{grid-template-columns:1fr 1fr;}
    .country-grid{grid-template-columns:repeat(2,1fr);}
    .plans{grid-template-columns:1fr;}
  }
  @media (max-width:520px){
    .news-grid{grid-template-columns:1fr;}
    .country-grid{grid-template-columns:1fr 1fr;}
  }
</style>
</head>
<body>

<header>
  <div class="nav-wrap">
    <div class="logo" data-i18n="logo"><em>Africa</em>land</div>
    <nav class="primary-nav">
      <a href="#actualites" data-i18n="nav1">Actualités</a>
      <a href="#pays" data-i18n="nav2">Pays &amp; Histoire</a>
      <a href="#abonnement" data-i18n="nav3">Abonnement</a>
    </nav>
    <div class="nav-right">
      <select id="langSelect" onchange="setLang(this.value)">
        <option value="fr">🌍 Français</option>
        <option value="en">🌍 English</option>
      </select>
      <a href="#abonnement" class="btn btn-gold" data-i18n="navCta">S'abonner</a>
    </div>
  </div>
  <div class="kente-rule"></div>
</header>

<div class="hero">
  <div>
    <span class="hero-eyebrow" data-i18n="heroEyebrow">54 pays, une seule plateforme</span>
    <h1 data-i18n="heroTitle">L'actualité et l'histoire de l'Afrique, racontées pays par pays.</h1>
    <p class="lede" data-i18n="heroLede">Africaland réunit les journaux locaux et l'histoire de chaque pays du continent en un seul endroit, dans la langue de chaque lecteur.</p>
    <div class="hero-actions">
      <a href="#pays" class="btn btn-gold" data-i18n="heroBtn1">Explorer les pays</a>
      <a href="#abonnement" class="btn btn-outline" data-i18n="heroBtn2">Voir les abonnements</a>
    </div>
  </div>
  <div class="hero-side">
    <h3 data-i18n="tickerTitle">À la une en ce moment</h3>
    <div id="tickerList"></div>
  </div>
</div>

<!-- PUBLICITÉ GOOGLE ADSENSE (Banière sous le Hero) -->
<div class="ad-banner-container">
  <ins class="adsbygoogle"
       style="display:block"
       data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
       data-ad-slot="1234567890"
       data-ad-format="auto"
       data-full-width-responsive="true"></ins>
  <script>
       (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
</div>

<section id="actualites">
  <div class="section-head">
    <div>
      <h2 data-i18n="newsTitle">Actualités du continent</h2>
      <p data-i18n="newsSub">Filtrez par type de contenu — les résumés s'adaptent à la langue de chaque pays.</p>
    </div>
  </div>
  <div class="filter-row" id="newsFilters">
    <button class="pill active" data-cat="all" data-i18n="filterAll">Tout</button>
    <button class="pill" data-cat="actualite" data-i18n="filterActu">Actualité</button>
    <button class="pill" data-cat="documentation" data-i18n="filterDoc">Documentation</button>
    <button class="pill" data-cat="innovation" data-i18n="filterInno">Innovation</button>
    <button class="pill" data-cat="histoire" data-i18n="filterHist">Histoire</button>
  </div>
  <div class="news-grid" id="newsGrid"></div>
</section>

<!-- PUBLICITÉ GOOGLE ADSENSE (Banière entre Actualités et Pays) -->
<div class="ad-banner-container">
  <ins class="adsbygoogle"
       style="display:block"
       data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
       data-ad-slot="1234567890"
       data-ad-format="auto"
       data-full-width-responsive="true"></ins>
  <script>
       (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
</div>

<section id="pays">
  <div class="section-head">
    <div>
      <h2 data-i18n="countriesTitle">Pays &amp; histoire</h2>
      <p data-i18n="countriesSub">Cliquez sur un pays pour lire son histoire et ses actualités locales.</p>
    </div>
  </div>
  <div class="region-tabs" id="regionTabs"></div>
  <div class="country-grid" id="countryGrid"></div>
</section>

<section id="abonnement">
  <div class="section-head">
    <div>
      <h2 data-i18n="pricingTitle">Abonnement</h2>
      <p data-i18n="pricingSub">Un tarif adapté à votre localisation, détecté automatiquement.</p>
    </div>
  </div>

  <div class="region-toggle" id="regionToggle">
    <button class="active" data-region="africa" data-i18n="toggleAfrica">Résidents en Afrique</button>
    <button data-region="intl" data-i18n="toggleIntl">Hors Afrique</button>
  </div>
  <div class="pricing-note" data-i18n="pricingNote">Détecté via votre position — modifiable à tout moment.</div>

  <div class="plans">
    <div class="plan-card">
      <div class="plan-name" data-i18n="freeName">GRATUIT</div>
      <div class="plan-price">0<span> <span id="freeCurrency">FCFA</span></span></div>
      <div class="plan-cadence" data-i18n="freeCadence">Toujours gratuit</div>
      <ul class="plan-features">
        <li><span class="dot">✓</span><span data-i18n="freeF1">Accès aux fiches pays et à l'histoire</span></li>
        <li><span class="dot">✓</span><span data-i18n="freeF2">Actualités des journaux locaux, avec publicités</span></li>
        <li><span class="dot">✓</span><span data-i18n="freeF3">3 filtres de préférence au choix</span></li>
      </ul>
    </div>
    <div class="plan-card premium">
      <div class="plan-name" style="color:var(--gold)" data-i18n="premName">PREMIUM</div>
      <div class="plan-price"><span id="premPrice">200</span><span> <span id="premCurrency">FCFA</span> <span data-i18n="perMonth">/ mois</span></span></div>
      <div class="plan-cadence" data-i18n="premCadence">Facturation mensuelle, sans engagement</div>
      <ul class="plan-features">
        <li><span class="dot">✓</span><span data-i18n="premF1">Tout le contenu gratuit, sans publicité</span></li>
        <li><span class="dot">✓</span><span data-i18n="premF2">Notifications d'actualités en direct sur votre téléphone</span></li>
        <li><span class="dot">✓</span><span data-i18n="premF3">Préférences illimitées et résumés automatiques traduits</span></li>
        <li><span class="dot">✓</span><span data-i18n="premF4">Accès aux archives historiques complètes</span></li>
      </ul>
      <div class="push-demo">
        <span data-i18n="pushLabel">Recevoir les actualités sur mon téléphone</span>
        <button class="switch" id="pushSwitch" onclick="this.classList.toggle('on')"></button>
      </div>
    </div>
