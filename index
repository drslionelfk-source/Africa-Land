function iconSvg(name){
  return `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${ICONS[name]||ICONS.globe}</svg>`;
}

/* render ticker */
function renderTicker(){
  const list = document.getElementById("tickerList");
  list.innerHTML = "";
  newsSamples.slice(0,4).forEach(n=>{
    const c = countries.find(c=>c.id===n.country);
    const div = document.createElement("div");
    div.className = "ticker-item";
    div.innerHTML = `<span class="ticker-thumb img-${n.cat}">${iconSvg(n.icon)}<span class="mini-flag">${c.flag}</span></span>
      <div><strong>${n.title}</strong><span class="meta">${n.source}</span></div>`;
    list.appendChild(div);
  });
}

/* render news grid with filter */
let activeCat = "all";
function renderNews(){
  const grid = document.getElementById("newsGrid");
  grid.innerHTML = "";
  const filtered = activeCat==="all" ? newsSamples : newsSamples.filter(n=>n.cat===activeCat);
  filtered.forEach(n=>{
    const c = countries.find(c=>c.id===n.country);
    const cname = currentLang==="en" ? c.nameEn : c.name;
    const catLabel = dict[currentLang]["filter"+n.cat.charAt(0).toUpperCase()+n.cat.slice(1,4)] || n.cat;
    const div = document.createElement("div");
    div.className = "news-card";
    div.innerHTML = `
      <div class="card-image img-${n.cat}">
        ${iconSvg(n.icon)}
        <span class="cat-tag cat-${n.cat}">${catLabelFor(n.cat)}</span>
        <span class="flag-badge">${c.flag}</span>
      </div>
      <div class="card-body">
        <h3>${n.title}</h3>
        <p class="ai-summary">${n.summary}</p>
        <div class="source-line">${cname} · ${n.source}</div>
        <a class="read-original" href="${n.url}" target="_blank" rel="noopener noreferrer">${dict[currentLang].readFull}</a>
      </div>`;
    grid.appendChild(div);
  });
}
function catLabelFor(cat){
  const map = {actualite:"filterActu", documentation:"filterDoc", innovation:"filterInno", histoire:"filterHist"};
  return dict[currentLang][map[cat]];
}
document.querySelectorAll("#newsFilters .pill").forEach(p=>{
  p.addEventListener("click", ()=>{
    document.querySelectorAll("#newsFilters .pill").forEach(x=>x.classList.remove("active"));
    p.classList.add("active");
    activeCat = p.dataset.cat;
    renderNews();
  });
});

/* render regions + countries */
const regions = [
  {id:"all", fr:"Toutes les régions", en:"All regions"},
  {id:"ouest", fr:"Afrique de l'Ouest", en:"West Africa"},
  {id:"nord", fr:"Afrique du Nord", en:"North Africa"},
  {id:"est", fr:"Afrique de l'Est", en:"East Africa"},
  {id:"centrale", fr:"Afrique Centrale", en:"Central Africa"},
  {id:"australe", fr:"Afrique Australe", en:"Southern Africa"},
];
let activeRegion = "all";
function renderRegionTabs(){
  const wrap = document.getElementById("regionTabs");
  wrap.innerHTML = "";
  regions.forEach(r=>{
    const btn = document.createElement("button");
    btn.className = "region-tab" + (r.id===activeRegion ? " active" : "");
    btn.textContent = currentLang==="en" ? r.en : r.fr;
    btn.onclick = ()=>{ activeRegion = r.id; renderRegionTabs(); renderCountries(); };
    wrap.appendChild(btn);
  });
}
function renderCountries(){
  renderRegionTabs();
  const grid = document.getElementById("countryGrid");
  grid.innerHTML = "";
  const list = activeRegion==="all" ? countries : countries.filter(c=>c.region===activeRegion);
  list.forEach(c=>{
    const card = document.createElement("button");
    card.className = "country-card";
    card.innerHTML = `<span class="flag">${c.flag}</span>
      <h4>${currentLang==="en"?c.nameEn:c.name}</h4>
      <span class="cap">${c.capital}</span>`;
    card.onclick = ()=>openDetail(c.id);
    grid.appendChild(card);
  });
}

/* detail overlay */
function openDetail(id){
  const c = countries.find(c=>c.id===id);
  document.getElementById("dFlag").textContent = c.flag;
  document.getElementById("dName").textContent = currentLang==="en" ? c.nameEn : c.name;
  document.getElementById("dMeta").textContent =
    `${dict[currentLang].capitalLabel}: ${c.capital}  ·  ${dict[currentLang].langLabel}: ${c.lang}`;
  const histWrap = document.getElementById("dHistory");
  histWrap.innerHTML = "";
  c.timeline.forEach(era=>{
    const item = document.createElement("div");
    item.className = "timeline-item";
    const period = currentLang==="en" ? era.periodEn : era.period;
    const text = currentLang==="en" ? era.textEn : era.text;
    item.innerHTML = `<span class="tl-period">${period}</span><p>${text}</p>`;
    histWrap.appendChild(item);
  });
  const newsWrap = document.getElementById("dNews");
  newsWrap.innerHTML = "";
  const related = newsSamples.filter(n=>n.country===id);
  if(related.length===0){
    const p = document.createElement("p");
    p.style.color = "var(--ink-faint)"; p.style.fontSize = "14px";
    p.textContent = currentLang==="en" ? "No sample news for this country yet." : "Pas encore d'actualité d'exemple pour ce pays.";
    newsWrap.appendChild(p);
  } else {
    related.forEach(n=>{
      const row = document.createElement("div");
      row.className = "detail-news-item";
      row.innerHTML = `
        <div class="detail-news-thumb img-${n.cat}">
          ${iconSvg(n.icon)}
          <span class="mini-flag">${countries.find(c=>c.id===n.country).flag}</span>
        </div>
        <div style="flex:1">
          <div style="display:flex; justify-content:space-between; gap:10px; margin-bottom:6px;">
            <strong style="font-size:14px">${n.title}</strong>
            <span class="cat-tag cat-${n.cat}">${catLabelFor(n.cat)}</span>
          </div>
          <p class="ai-summary" style="margin-bottom:6px">${n.summary}</p>
          <a class="read-original" style="border-top:none; padding-top:0" href="${n.url}" target="_blank" rel="noopener noreferrer">${dict[currentLang].readFull} — ${n.source}</a>
        </div>`;
      newsWrap.appendChild(row);
    });
  }
  document.getElementById("overlay").classList.add("open");
}
function closeDetail(){ document.getElementById("overlay").classList.remove("open"); }

/* init */
renderTicker();
renderNews();
renderCountries();
</script>
